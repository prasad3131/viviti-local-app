{
  "expo": {
    "name": "Viviti Local",
    "slug": "viviti-local-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "icon": "./assets/icon.png",
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.viviti.local",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#257af0"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a0e8eebe-d5d8-4135-95a5-c08b2feb2066"
      }
    }
  }
}
